{
  "name": "ai-recruiter-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AI Recruiter Agency - Monorepo (backend + frontend) orchestrated with Turborepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"turbo run dev --filter=backend...\" \"turbo run dev --filter=frontend...\"",
