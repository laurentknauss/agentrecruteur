# Backend environment
# Copier ce fichier en `backend/.env` puis renseigner les valeurs (jamais commité).

# ── Mode démo (vitrine publique / protection crédits OpenAI) ─────────────
# DEMO_LOCK=1 bloque POST /api/upload-cv et /api/candidate/:id/ask (403),
# donc aucune consommation OpenAI tant que le verrou est actif.
# En démo : laisser OPENAI_API_KEY VIDE.
DEMO_LOCK=1

# ── OpenAI (requis uniquement si DEMO_LOCK est retiré) ────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
GPT_MODEL=gpt-5.5

# ── MongoDB Atlas (optionnel — fallback automatique en stockage mémoire) ──
MONGODB_ATLAS_URI=
MONGODB_DATABASE=cv-inspector

# ── Serveur (optionnel) ───────────────────────────────────────────────────
# PORT=3001
