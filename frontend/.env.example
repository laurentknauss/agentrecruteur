# Next.js (frontend) — environment local .env.local / serveur .env.local
# Copier en `frontend/.env.local` (jamais commité).

# OpenAI (requis : l'upload et le Q&A appellent le modèle)
OPENAI_API_KEY=
GPT_MODEL=gpt-5.5

# MongoDB Atlas (optionnel — repli mémoire automatique, non persistant)
MONGODB_ATLAS_URI=
MONGODB_DATABASE=cv-inspector

# Garde-fou des routes de données (/api/candidates, /api/candidate/:id, /ask).
# OBLIGATOIRE en production : sans ADMIN_TOKEN, ces routes répondent 503 (fail-closed).
# Appel : Authorization: Bearer <ADMIN_TOKEN>
# La vérification d'identité fine (multi-comptes) sera assurée par Clerk.
ADMIN_TOKEN=

# Propriétaire associé aux candidats lus/écrits avec le jeton admin (optionnel).
# Laisser vide = portée administrateur globale (aucun filtrage par propriétaire).
ADMIN_OWNER_ID=

# Bornes d'upload (non configurables, documentées ici) :
#   - corps multipart max 11 Mo (pré-contrôle Content-Length → 413)
#   - fichier PDF max 10 Mo
#   - CV max 20 pages et 60 000 caractères transmis au LLM
#   - 5 dépôts d'upload par IP et par heure
# Limite équivalente à poser côté reverse proxy : voir deploy/Caddyfile.agentrecruteur.example
